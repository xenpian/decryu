{
  "name": "DeCry",
  "version": "1.0.0",
  "description": "UI Clone",
  "main": "main.js",
  "scripts": {
    "start": "electron . --no-sandbox",
    "build": "electron-builder --win portable"
  },
  "build": {
    "appId": "com.decry.app",
    "win": {
      "target": "portable"
    },
    "portable": {
      "artifactName": "${productName}Portable.${ext}"
    }
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^26.8.1"
  },
  "dependencies": {
    "socket.io-client": "^4.8.3"
  }
}